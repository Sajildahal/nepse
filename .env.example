# ============================================================================
# NEPSE Intelligence AI - Environment Configuration Template
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connections (TimescaleDB / PostgreSQL)
DATABASE_URL=postgresql://nepse_user:nepse_secure_pass@localhost:5432/nepse_intelligence?schema=public

# In-Memory & Cache Store
REDIS_URL=redis://localhost:6379

# Optional: protect /log, /api/log and /api/log/stream.
# If set, pass this value as the `token` query param or `X-Log-Token` header.
# LOG_VIEW_TOKEN=change-me-to-a-long-random-value

# Authentication & JWT Secrets
JWT_SECRET=super_secret_nepse_intelligence_jwt_signing_key_2026
NEXTAUTH_SECRET=another_high_entropy_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# AI & LLM Provider Keys (Interchangeable)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_PROVIDER=openai # openai | anthropic | local

# Market Data Providers (Licensed / Authorised Gateways)
NEPSE_API_BASE_URL=https://api.nepalstock.com/v1
NEPSE_API_TOKEN=your_licensed_nepse_data_feed_token
SEBON_DISCLOSURES_FEED_URL=https://disclosures.sebon.gov.np/feed

# Nepal Payment Gateways (Commercial Subscriptions)
ESEWA_MERCHANT_ID=EPAYTEST

# PostgreSQL / TimescaleDB (used by docker-compose; override for real deployments)
POSTGRES_USER=nepse_user
POSTGRES_PASSWORD=nepse_secure_pass
POSTGRES_DB=nepse_intelligence

# NEPSE public API (live market data)
NEPSE_BASE_URL=https://www.nepalstock.com
# NEPSE_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36

# DNS resolver used by the web container (docker-compose.yml).
# Defaults to TailScale MagicDNS, which is what this host uses. Override with
# your own resolver if the host does not run TailScale (e.g. 1.1.1.1).
DNS_SERVER=100.100.100.100

ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
KHALTI_PUBLIC_KEY=live_public_key_here
KHALTI_SECRET_KEY=live_secret_key_here
CONNECTIPS_MERCHANT_ID=your_connectips_id
CONNECTIPS_APP_NAME=NEPSE_AI
